{
  "name": "react-firetail",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Common tools for react apps - compatible with react18+, firebase9+, reactfire4+, tailwind3+",
  "sideEffects": false,
  "keywords": [],
  "author": "WebberTakken <webber@takken.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/webbertakken/react-firetail.git"
  },
  "bugs": {
    "url": "https://github.com/webbertakken/react-firetail/issues"
  },
  "homepage": "https://github.com/webbertakken/react-firetail",
  "peerDependencies": {
    "@loadable/component": "^5.15.2",
    "firebase": "^9.6.1",
    "postcss": "^8.4.5",
    "react": "^18.0.0-rc.0",
    "react-dom": "^18.0.0-rc.0",
    "react-hot-toast": "^2.1.1",
    "reactfire": "^4.2.1",
    "tailwindcss": "^3.0.8",
    "web-vitals": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vitest/coverage-istanbul": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "9",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^7",
    "vitest": "^4"
  },
  "scripts": {
    "test": "node scripts/ensure-husky.mjs && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "yarn oxlint --report-unused-disable-directives",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.@(ts|tsx|mts|js|jsx|mjs|cjs)": [
      "oxlint --fix --quiet",
      "oxfmt --write"
    ],
    "*.@(json|jsonc|json5|md|mdx|yaml|yml|css|scss|sass|html|toml)": "oxfmt --write",
    ".github/workflows/*.@(yml|yaml)": "actionlint"
  },
  "packageManager": "yarn@4.14.1"
}
